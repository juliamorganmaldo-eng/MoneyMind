# Copy this file to .env and fill in values. .env must NOT be committed.

# Port the web server listens on.
PORT=3001

# PostgreSQL connection string for the local database.
# Example for a local role named `moneymind` with db `moneymind_web`:
#   postgresql://moneymind:PASSWORD@localhost:5432/moneymind_web
DATABASE_URL=postgresql://moneymind:CHANGE_ME@localhost:5432/moneymind_web

# Strong random secret used to sign session cookies. Must be at least 32 chars.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=replace-me-with-a-48-byte-base64-value

# Set to "production" when deployed. Leave unset or "development" locally.
NODE_ENV=development

# AES-256-GCM key used to encrypt Plaid access tokens at rest.
# Must decode to AT LEAST 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace-me-with-a-32-byte-base64-value

# Plaid. Use the sandbox secret while PLAID_ENV=sandbox; rotate per environment.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET_SANDBOX=
# PLAID_SECRET_DEVELOPMENT=
# PLAID_SECRET_PRODUCTION=
