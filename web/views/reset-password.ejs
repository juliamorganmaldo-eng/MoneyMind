<%- include('partials/head', { title: 'Reset password' }) %>
<body class="auth-body">
  <main class="auth-card">
    <div class="brand">
      <span class="brand-mark">◆</span>
      <span class="brand-name">MoneyMind</span>
    </div>
    <h1>Choose a new password</h1>
    <p class="subtitle">Pick something at least 10 characters long.</p>

    <div id="rp-error" class="alert alert-error" hidden></div>

    <form id="rp-form" autocomplete="off" novalidate>
      <input type="hidden" id="token" value="<%= token %>" />

      <label for="new_password">New password</label>
      <input id="new_password" name="new_password" type="password" required minlength="10" autocomplete="new-password" />

      <label for="confirm">Confirm new password</label>
      <input id="confirm" name="confirm" type="password" required minlength="10" autocomplete="new-password" />

      <button type="submit" class="btn-primary">Update password</button>
    </form>

    <p class="foot">
      <a href="/login">Back to sign in</a>
    </p>
  </main>

  <script>
    (function () {
      var form = document.getElementById('rp-form');
      var err = document.getElementById('rp-error');
      function showErr(m) { err.textContent = m; err.hidden = false; }

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        err.hidden = true;
        var pw = form.new_password.value;
        var confirm = form.confirm.value;
        if (pw.length < 10) return showErr('Password must be at least 10 characters.');
        if (pw !== confirm) return showErr("Passwords don't match.");
        var btn = form.querySelector('button[type=submit]');
        btn.disabled = true;
        try {
          var r = await fetch('/api/auth/reset-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              token: document.getElementById('token').value,
              new_password: pw,
            }),
          });
          var j = await r.json().catch(function () { return {}; });
          if (!r.ok) {
            btn.disabled = false;
            return showErr(j.error || 'Could not reset password.');
          }
          window.location.href = j.redirect || '/login?reset=ok';
        } catch (e2) {
          btn.disabled = false;
          showErr('Network error. Please try again.');
        }
      });
    })();
  </script>
</body>
</html>
