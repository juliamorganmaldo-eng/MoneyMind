<%- include('partials/head', { title: 'Forgot password' }) %>
<body class="auth-body">
  <main class="auth-card">
    <div class="brand">
      <span class="brand-mark">◆</span>
      <span class="brand-name">MoneyMind</span>
    </div>
    <h1>Forgot password</h1>
    <p class="subtitle">Enter the email on your account and we'll send you a reset link.</p>

    <div id="fp-status" class="alert alert-info" hidden></div>

    <form id="fp-form" autocomplete="on" novalidate>
      <label for="email">Email</label>
      <input id="email" name="email" type="email" required autocomplete="email" />
      <button type="submit" class="btn-primary">Send reset link</button>
    </form>

    <p class="foot">
      Remembered it? <a href="/login">Back to sign in</a>
    </p>
  </main>

  <script>
    (function () {
      var form = document.getElementById('fp-form');
      var status = document.getElementById('fp-status');
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        var btn = form.querySelector('button[type=submit]');
        btn.disabled = true;
        status.hidden = true;
        try {
          var r = await fetch('/api/auth/forgot-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: form.email.value }),
          });
          var j = await r.json().catch(function () { return {}; });
          // Always show the same generic message — this matches the
          // server's no-enumeration policy.
          status.textContent = j.message || "If an account exists with that email, we've sent a reset link.";
          status.hidden = false;
        } catch (err) {
          status.textContent = 'Something went wrong. Please try again.';
          status.hidden = false;
        } finally {
          btn.disabled = false;
        }
      });
    })();
  </script>
  <%- include('partials/footer') %>
</body>
</html>
