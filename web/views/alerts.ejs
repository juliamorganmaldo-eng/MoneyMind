<%- include('partials/head', { title: 'Alerts' }) %>
<body class="app-body">
  <header class="app-header">
    <div class="brand">
      <span class="brand-mark">◆</span>
      <span class="brand-name">MoneyMind</span>
    </div>
    <div class="header-actions">
      <a href="/dashboard" class="btn-ghost btn-inline">← Dashboard</a>
      <a href="/transactions" class="btn-ghost btn-inline">Transactions</a>
      <a href="/categories" class="btn-ghost btn-inline">Categories</a>
      <a href="/budgets" class="btn-ghost btn-inline">Budgets</a>
      <form method="POST" action="/logout" class="logout-form">
        <button type="submit" class="btn-ghost">Log out</button>
      </form>
    </div>
  </header>

  <main class="app-main">
    <h1 class="page-title">Low-balance alerts</h1>
    <p class="subtitle" style="margin-bottom: 1.25rem;">
      Set a threshold per account. When the balance drops below it, you'll see a warning on the dashboard.
    </p>

    <% if (account_count === 0) { %>
      <section class="panel">
        <%- include('partials/no-accounts-cta', { message: 'Connect a bank to set low-balance alerts on each of your accounts.' }) %>
      </section>
    <% } else { %>
      <section class="panel">
        <div id="alerts-error" class="alert alert-error" hidden></div>
        <div id="alerts-list">
          <div class="empty"><span class="spinner-inline">…</span> Loading…</div>
        </div>
      </section>
    <% } %>
  </main>

  <% if (account_count > 0) { %>
    <script src="/js/alerts.js"></script>
  <% } %>
  <%- include('partials/footer') %>
</body>
</html>
