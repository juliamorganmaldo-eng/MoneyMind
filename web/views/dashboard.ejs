<%- include('partials/head', { title: 'Dashboard' }) %>
<body class="app-body">
  <header class="app-header">
    <div class="brand">
      <span class="brand-mark">◆</span>
      <span class="brand-name">MoneyMind</span>
    </div>
    <div class="header-actions">
      <a href="/transactions"  class="btn-ghost btn-inline">Transactions</a>
      <a href="/categories"    class="btn-ghost btn-inline">Categories</a>
      <a href="/budgets"       class="btn-ghost btn-inline">Budgets</a>
      <a href="/alerts"        class="btn-ghost btn-inline">Alerts</a>
      <a href="/subscriptions" class="btn-ghost btn-inline">Subscriptions</a>
      <form method="POST" action="/logout" class="logout-form">
        <button type="submit" class="btn-ghost">Log out</button>
      </form>
    </div>
  </header>

  <main class="app-main">
    <%# Alerts panel — only rendered if there's something to show. JS sets hidden=false. %>
    <section id="alerts-panel" class="panel alerts-panel" hidden>
      <h2 class="panel-title">⚠ Alerts</h2>
      <ul id="alerts-panel-list"></ul>
    </section>

    <section class="panel">
      <div class="panel-header">
        <div>
          <h1>Welcome, <%= email %></h1>
          <p class="subtitle">Connect a bank to start tracking your accounts.</p>
        </div>
        <button id="connect-bank" class="btn-primary btn-inline" type="button">
          + Connect Bank
        </button>
      </div>
      <div id="connect-status" class="alert" role="status" hidden></div>
    </section>

    <% if (items && items.length > 0) { %>
      <section class="panel net-panel">
        <div class="net-label">Total Net Position</div>
        <div id="net-amount" class="net-amount">
          <span class="spinner-inline" aria-label="loading">…</span>
        </div>
      </section>

      <section class="panel">
        <div class="panel-header">
          <h2 class="panel-title">Connected Accounts</h2>
          <div class="sync-controls">
            <span
              id="last-synced"
              class="last-synced"
              data-since="<%= items.reduce((m, i) => (m && new Date(m) > new Date(i.updated_at)) ? m : i.updated_at, null) %>"
            ></span>
            <button id="sync-btn" class="btn-ghost btn-inline" type="button">
              ↻ Sync transactions
            </button>
          </div>
        </div>
        <div id="sync-status" class="alert" role="status" hidden></div>
        <div id="institutions-list">
          <div class="empty"><span class="spinner-inline">…</span> Loading accounts…</div>
        </div>
      </section>

      <section class="panel">
        <div class="panel-header">
          <h2 class="panel-title">Spending This Month by Category</h2>
          <a href="/categories" class="btn-ghost btn-inline">Manage categories →</a>
        </div>
        <div id="spending-chart">
          <div class="empty"><span class="spinner-inline">…</span> Loading…</div>
        </div>
      </section>

      <section class="panel">
        <div class="panel-header">
          <h2 class="panel-title">Recent Transactions</h2>
          <a href="/transactions" class="btn-ghost btn-inline">View all transactions →</a>
        </div>
        <div id="txn-list">
          <div class="empty"><span class="spinner-inline">…</span> Loading…</div>
        </div>
      </section>
    <% } else { %>
      <section class="panel">
        <h2 class="panel-title">No banks connected</h2>
        <p class="empty">Click <strong>+ Connect Bank</strong> to add your first institution.</p>
      </section>
    <% } %>
  </main>

  <script src="https://cdn.plaid.com/link/v2/stable/link-initialize.js"></script>
  <script src="/js/dashboard.js"></script>
</body>
</html>
