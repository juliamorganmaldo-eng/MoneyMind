<%- include('partials/head', { title: 'Dashboard' }) %>
<body class="app-body">
  <header class="app-header">
    <div class="brand">
      <span class="brand-mark">◆</span>
      <span class="brand-name">MoneyMind</span>
    </div>
    <form method="POST" action="/logout" class="logout-form">
      <button type="submit" class="btn-ghost">Log out</button>
    </form>
  </header>

  <main class="app-main">
    <section class="panel">
      <div class="panel-header">
        <div>
          <h1>Welcome, <%= email %></h1>
          <p class="subtitle">Connect a bank to start tracking your accounts.</p>
        </div>
        <button id="connect-bank" class="btn-primary btn-inline" type="button">
          + Connect Bank
        </button>
      </div>

      <div id="connect-status" class="alert" role="status" hidden></div>
    </section>

    <section class="panel">
      <h2 class="panel-title">Connected Accounts</h2>

      <% if (!items || items.length === 0) { %>
        <p class="empty">No banks connected yet. Click <strong>Connect Bank</strong> to add one.</p>
      <% } else { %>
        <ul class="institution-list">
          <% items.forEach(function(item) { %>
            <li class="institution">
              <div class="institution-name">
                <%= item.institution_name || 'Unnamed institution' %>
              </div>
              <div class="institution-meta">
                <%= item.account_count %> account<%= item.account_count === 1 ? '' : 's' %>
                · connected <%= new Date(item.created_at).toLocaleDateString() %>
              </div>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </section>

    <% if (items && items.length > 0) { %>
      <section class="panel">
        <div class="panel-header">
          <h2 class="panel-title">Recent Transactions</h2>
          <button id="sync-btn" class="btn-ghost btn-inline" type="button">
            ↻ Sync transactions
          </button>
        </div>
        <div id="sync-status" class="alert" role="status" hidden></div>
        <div id="txn-list" class="empty">Loading…</div>
      </section>
    <% } %>
  </main>

  <script src="https://cdn.plaid.com/link/v2/stable/link-initialize.js"></script>
  <script>
    (function () {
      var btn = document.getElementById('connect-bank');
      var status = document.getElementById('connect-status');

      function showStatus(text, kind) {
        status.textContent = text;
        status.className = 'alert ' + (kind === 'error' ? 'alert-error' : 'alert-info');
        status.hidden = false;
      }
      function clearStatus() { status.hidden = true; status.textContent = ''; }

      async function startLink() {
        clearStatus();
        btn.disabled = true;

        // 1. Get a link token (auth-required, server scopes it to this user).
        let linkToken;
        try {
          const r = await fetch('/api/plaid/create-link-token', {
            method: 'POST',
            credentials: 'same-origin',
          });
          if (!r.ok) throw new Error('status ' + r.status);
          const json = await r.json();
          linkToken = json.link_token;
        } catch (e) {
          btn.disabled = false;
          showStatus('Could not start Plaid Link. Check the server logs.', 'error');
          return;
        }

        // 2. Open Plaid Link with that token.
        var handler = Plaid.create({
          token: linkToken,
          onSuccess: async function (public_token /*, metadata */) {
            showStatus('Connecting…', 'info');
            try {
              const r = await fetch('/api/plaid/exchange-public-token', {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ public_token: public_token }),
              });
              if (!r.ok) {
                const j = await r.json().catch(function () { return {}; });
                throw new Error(j.error || ('status ' + r.status));
              }
              // Reload so the dashboard renders the newly-saved item.
              window.location.reload();
            } catch (e) {
              btn.disabled = false;
              showStatus('Could not save the bank: ' + e.message, 'error');
            }
          },
          onExit: function (err /*, metadata */) {
            btn.disabled = false;
            if (err) {
              showStatus(err.display_message || err.error_message || 'Plaid Link closed.', 'error');
            }
          },
        });
        handler.open();
      }

      btn.addEventListener('click', startLink);

      // ── Recent Transactions + Sync ─────────────────────────────────────
      var syncBtn = document.getElementById('sync-btn');
      var syncStatus = document.getElementById('sync-status');
      var txnList = document.getElementById('txn-list');

      function escapeHtml(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      }
      function fmtMoney(amt, ccy) {
        // Plaid convention: positive amount = money OUT of the account.
        // We display outflows as negative (red) and inflows as positive (green).
        var n = Number(amt);
        if (!isFinite(n)) return '';
        var symbol = ccy === 'USD' ? '$' : (ccy ? ccy + ' ' : '');
        var sign = n > 0 ? '−' : (n < 0 ? '+' : '');
        return sign + symbol + Math.abs(n).toFixed(2);
      }
      function txnSign(amt) { return Number(amt) > 0 ? 'out' : 'in'; }

      async function loadRecent() {
        if (!txnList) return;
        try {
          var r = await fetch('/api/transactions?limit=10', { credentials: 'same-origin' });
          if (!r.ok) throw new Error('status ' + r.status);
          var json = await r.json();
          var rows = json.transactions || [];
          if (rows.length === 0) {
            txnList.className = 'empty';
            txnList.innerHTML = 'No transactions yet. Click <strong>Sync transactions</strong> to fetch them.';
            return;
          }
          txnList.className = '';
          txnList.innerHTML = '<ul class="txn-list">' + rows.map(function (t) {
            return '<li class="txn">'
              + '<span class="txn-date">' + escapeHtml(t.date || '') + '</span>'
              + '<span class="txn-name">' + escapeHtml(t.merchant_name || t.name || 'Unknown')
                + (t.pending ? ' <span class="txn-pending">pending</span>' : '')
                + '</span>'
              + '<span class="txn-amount txn-' + txnSign(t.amount) + '">'
                + escapeHtml(fmtMoney(t.amount, t.iso_currency_code))
                + '</span>'
              + '</li>';
          }).join('') + '</ul>';
        } catch (e) {
          txnList.className = 'empty';
          txnList.innerHTML = 'Could not load transactions.';
        }
      }

      if (syncBtn) {
        syncBtn.addEventListener('click', async function () {
          syncBtn.disabled = true;
          syncStatus.hidden = false;
          syncStatus.className = 'alert alert-info';
          syncStatus.textContent = 'Syncing…';
          try {
            var r = await fetch('/api/transactions/sync', {
              method: 'POST', credentials: 'same-origin',
            });
            if (!r.ok) {
              var j = await r.json().catch(function () { return {}; });
              throw new Error(j.error || ('status ' + r.status));
            }
            var c = await r.json();
            var parts = ['Added ' + c.added_count + ' new transaction' + (c.added_count === 1 ? '' : 's')];
            if (c.modified_count) parts.push('updated ' + c.modified_count);
            if (c.removed_count)  parts.push('removed ' + c.removed_count);
            syncStatus.textContent = parts.join(', ') + '.';
            await loadRecent();
          } catch (e) {
            syncStatus.className = 'alert alert-error';
            syncStatus.textContent = 'Sync failed: ' + e.message;
          } finally {
            syncBtn.disabled = false;
          }
        });
      }

      if (txnList) loadRecent();
    })();
  </script>
</body>
</html>
