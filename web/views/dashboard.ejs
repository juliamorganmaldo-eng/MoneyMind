<%- include('partials/head', { title: 'Dashboard' }) %>
<body class="app-body">
  <header class="app-header">
    <div class="brand">
      <span class="brand-mark">◆</span>
      <span class="brand-name">MoneyMind</span>
    </div>
    <div class="header-actions">
      <a href="/transactions"  class="btn-ghost btn-inline">Transactions</a>
      <a href="/categories"    class="btn-ghost btn-inline">Categories</a>
      <a href="/budgets"       class="btn-ghost btn-inline">Budgets</a>
      <a href="/subscriptions" class="btn-ghost btn-inline">Subscriptions</a>
      <a href="/net-worth"     class="btn-ghost btn-inline">Net Worth</a>
      <a href="/insights"      class="btn-ghost btn-inline">Insights</a>
      <a href="/findings"      class="btn-ghost btn-inline">Findings</a>
      <a href="/alerts"        class="btn-ghost btn-inline">Alerts</a>
      <form method="POST" action="/logout" class="logout-form">
        <button type="submit" class="btn-ghost">Log out</button>
      </form>
    </div>
  </header>

  <main class="app-main">
    <% if (typeof flash !== 'undefined' && flash) { %>
      <div class="alert alert-info" style="margin-bottom: 1rem;"><%= flash %></div>
    <% } %>

    <% if (!email_verified) { %>
      <%# Verify-email banner takes precedence over the first-run welcome:
          a brand-new user without verification needs to verify FIRST before
          they can connect a bank, so the welcome's CTA wouldn't work yet. %>
      <div class="banner-verify">
        <span>📬 <strong>Verify your email</strong> to unlock bank connections — check your inbox for the link.</span>
        <button id="resend-verify-btn" type="button" class="btn-ghost btn-inline">Resend verification</button>
        <span id="resend-verify-msg" class="banner-verify-msg" hidden></span>
      </div>
    <% } else if (items && items.length === 0) { %>
      <%# First-run welcome — only shown once email is verified AND there
          are no bank connections yet. The CTA reuses the existing
          #connect-bank handler in dashboard.js so the Plaid Link drop-in
          fires the same way as the secondary button below. %>
      <section class="welcome-hero">
        <h1>
          <%
            // Best-effort first name from the local part of the email.
            // Fallback to the full email if it's not friendly.
            var local = (email || '').split('@')[0];
            var first = local.split(/[._+-]/)[0];
            var displayName = first && /^[A-Za-z]+$/.test(first)
              ? first.charAt(0).toUpperCase() + first.slice(1).toLowerCase()
              : email;
          %>
          Welcome to MoneyMind, <%= displayName %>!
        </h1>
        <p>
          MoneyMind tracks your bank accounts in one place, spots
          recurring charges and price changes, and surfaces findings when
          something needs your attention.
        </p>
        <button id="connect-bank-hero" class="btn-primary" type="button">
          Connect your first bank
        </button>
        <p class="welcome-foot">🔒 Your data is encrypted and only visible to you.</p>
      </section>
    <% } %>

    <%# Findings panel — only rendered if there's something to show. JS sets hidden=false. %>
    <section id="findings-panel" class="panel findings-panel" hidden>
      <div class="panel-header">
        <h2 class="panel-title">Findings <span id="findings-new-badge" class="findings-new-badge" hidden></span></h2>
        <a href="/findings" class="btn-ghost btn-inline">View all findings →</a>
      </div>
      <div id="findings-panel-list"></div>
    </section>

    <%# When the first-run welcome hero is showing (verified, 0 items) the
        secondary "Welcome, [email]" panel + Connect Bank button is
        redundant — the hero is the CTA. Skip it then. %>
    <% var heroShown = email_verified && items && items.length === 0; %>
    <% if (!heroShown) { %>
      <section class="panel">
        <div class="panel-header">
          <div>
            <h1>Welcome, <%= email %></h1>
            <p class="subtitle">Connect a bank to start tracking your accounts.</p>
          </div>
          <button id="connect-bank" class="btn-primary btn-inline" type="button">
            + Connect Bank
          </button>
        </div>
        <div id="connect-status" class="alert" role="status" hidden></div>
      </section>
    <% } else { %>
      <%# Even when hidden, the JS still references #connect-status; render
          a minimal hidden version so error/info messages from the hero CTA
          have somewhere to land. %>
      <div id="connect-status" class="alert" role="status" hidden></div>
    <% } %>

    <% if (items && items.length > 0) { %>
      <section class="panel net-headline">
        <div class="net-headline-row">
          <div>
            <div class="net-label">Net Worth</div>
            <div id="nw-total" class="net-amount">
              <span class="spinner-inline" aria-label="loading">…</span>
            </div>
            <div class="net-sub-row">
              <span class="net-sub-label">Assets</span> <span id="nw-assets" class="net-positive">—</span>
              <span class="net-sub-label">·  Liabilities</span> <span id="nw-liabs" class="net-negative">—</span>
            </div>
          </div>
          <div class="net-actions">
            <button id="refresh-balances-btn" class="btn-ghost btn-inline" type="button">↻ Refresh balances</button>
            <a href="/net-worth" class="btn-ghost btn-inline">Manage classifications →</a>
          </div>
        </div>
        <div id="nw-mini-chart" class="nw-chart-mini"></div>
      </section>

      <section class="panel">
        <div class="panel-header">
          <h2 class="panel-title">Connected Accounts</h2>
          <div class="sync-controls">
            <span
              id="last-synced"
              class="last-synced"
              data-since="<%= items.reduce((m, i) => (m && new Date(m) > new Date(i.updated_at)) ? m : i.updated_at, null) %>"
            ></span>
            <button id="sync-btn" class="btn-ghost btn-inline" type="button">
              ↻ Sync transactions
            </button>
          </div>
        </div>
        <div id="sync-status" class="alert" role="status" hidden></div>
        <div id="institutions-list">
          <div class="empty"><span class="spinner-inline">…</span> Loading accounts…</div>
        </div>
      </section>

      <section class="panel">
        <div class="panel-header">
          <h2 class="panel-title">Spending This Month by Category</h2>
          <a href="/categories" class="btn-ghost btn-inline">Manage categories →</a>
        </div>
        <div id="spending-chart">
          <div class="empty"><span class="spinner-inline">…</span> Loading…</div>
        </div>
      </section>

      <section class="panel">
        <div class="panel-header">
          <h2 class="panel-title">Recent Transactions</h2>
          <a href="/transactions" class="btn-ghost btn-inline">View all transactions →</a>
        </div>
        <div id="txn-list">
          <div class="empty"><span class="spinner-inline">…</span> Loading…</div>
        </div>
      </section>
    <% } else if (!heroShown) { %>
      <%# Reached when items=0 but email NOT verified (hero is suppressed
          in favor of the verify banner above). Keep the legacy "no banks"
          panel so the user still sees a clear next step after they verify. %>
      <section class="panel">
        <h2 class="panel-title">No banks connected</h2>
        <p class="empty">Verify your email above, then click <strong>+ Connect Bank</strong> to add your first institution.</p>
      </section>
    <% } %>
  </main>

  <script src="https://cdn.plaid.com/link/v2/stable/link-initialize.js"></script>
  <script src="/js/dashboard.js"></script>
  <%- include('partials/footer') %>
</body>
</html>
