<%- include('partials/head', { title: 'Reset link invalid' }) %>
<body class="auth-body">
  <main class="auth-card">
    <div class="brand">
      <span class="brand-mark">◆</span>
      <span class="brand-name">MoneyMind</span>
    </div>
    <h1>This reset link is invalid or has expired</h1>
    <p class="subtitle">Reset links expire one hour after they're sent and can only be used once.</p>

    <p style="margin-top: 1.5rem;">
      <a href="/forgot-password" class="btn-primary" style="display:inline-block;text-decoration:none;text-align:center;">
        Request a new link
      </a>
    </p>

    <p class="foot">
      <a href="/login">Back to sign in</a>
    </p>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
